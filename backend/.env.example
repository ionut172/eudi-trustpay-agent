# Gemini API Key (Required for live ADK LLM orchestration; mock fallback works in local test mode)
GEMINI_API_KEY=""

# Adapter Mode: MOCK or LIVE
ADAPTER_MODE="MOCK"

# Model configuration
MODEL_NAME="gemini-2.5-flash"

# Server configuration
HOST="0.0.0.0"
PORT=8080
LOG_LEVEL="INFO"
APP_NAME="conversational_payments"

# External Verifier / Core Banking Endpoints (for LIVE mode)
LIVE_VERIFIER_URL="https://verifier.example.com"
LIVE_CORE_BANKING_URL="https://banking.example.com"

# Automatic authorization policy
AUTO_EXECUTE_VERIFIED_PAYMENTS="true"
ALLOW_MOCK_VERIFICATION="true"
MOCK_WALLET_AUTO_PRESENT="true"
